# ===== Smart Medicine Platform — Environment Variables =====
# Copy this to .env and fill in real values

# ----- Application -----
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_NAME=SmartMedicine

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smartmedicine
DB_POOL_SIZE=20
DB_ECHO=false

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Elasticsearch -----
ELASTICSEARCH_URL=http://elasticsearch:9200

# ----- JWT -----
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ----- OpenAI (Premium features) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ----- ML -----
ML_MODEL_PATH=./ml/models/symptom_classifier_v1.joblib
ML_CONFIDENCE_THRESHOLD=0.70

# ----- Google APIs -----
GOOGLE_MAPS_API_KEY=
GOOGLE_VISION_API_KEY=

# ----- Razorpay (Payments) -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PREMIUM_MONTHLY_PRICE_INR=99
PHARMACY_MONTHLY_PRICE_INR=499

# ----- OCR -----
OCR_PROVIDER=tesseract
TESSERACT_PATH=/usr/bin/tesseract

# ----- Notifications -----
FIREBASE_CREDENTIALS_PATH=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ----- Rate Limiting -----
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_PREDICT=5/minute

# ----- Monitoring -----
SENTRY_DSN=
LOG_LEVEL=INFO
